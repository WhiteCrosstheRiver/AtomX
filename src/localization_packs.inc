{"球半径 / Å",{"Rayon de sphère / Å","Kugelradius / Å","Radio de esfera / Å","Raio da esfera / Å","Радиус сферы / Å","球の半径 / Å"}},
{"棒半径 / Å",{"Rayon de bâton / Å","Stabradius / Å","Radio de varilla / Å","Raio do bastão / Å","Радиус стержня / Å","棒の半径 / Å"}},
